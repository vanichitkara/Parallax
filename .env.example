# Gemini API Key (get from https://aistudio.google.com/apikey)
GOOGLE_API_KEY="your-gemini-api-key-here"

# Gemini Model (options: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.5-pro)
# gemini-2.5-flash = best balance of quality and free tier limits
# gemini-2.5-flash-lite = highest free quota (1000 RPD) but lower quality
# gemini-2.5-pro = best quality but only 100 RPD free
GEMINI_MODEL="gemini-2.5-flash"

# Google Cloud Project (for deployment)
GOOGLE_CLOUD_PROJECT="your-project-id"

# Optional: Google Cloud Storage bucket for screenshots  
GCS_BUCKET="parallax-screenshots"
